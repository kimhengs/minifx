{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniFX",
  "version": "../package.json",
  "identifier": "com.minifx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniFX",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MiniFX",
    "category": "Video",
    "shortDescription": "Lightweight motion graphics and video effects editor",
    "longDescription": "MiniFX is a lightweight After Effects-style editor for motion graphics, video effects and quick edits, with an AI assistant.",
    "copyright": "MiniFX",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "fileAssociations": [
      {
        "ext": ["msproj"],
        "name": "MiniFX Project",
        "description": "MiniFX Project",
        "role": "Editor",
        "mimeType": "application/x-minifx-project"
      }
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/OWNER/REPO/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
